                               └─────────┬──────────┘
                                         │
                                         ▼
                               ┌────────────────────┐
                               │ Flask Application  │
                               │                    │
                               │  /                 │
                               │  /health           │
                               └─────────┬──────────┘
                                         │
                                         ▼
                               ┌────────────────────┐
                               │   Amazon           │
                               │   CloudWatch       │
                               │                    │
                               │ • Logs             │
